@base = [A B C];
@left = [a b c];
@right = [one two three];
@all = [@base @left @right];

lookup test {
do  forlet i,b = enumerate(feaclass('base'));
    let l = feaclass('left')[i];
    let r = feaclass('right')[i];
    {
    sub $b by $l $r;
    }
} test;

lookup test1 {
    sub @all @right by @all;
} test1;

@A = [ga1 ga2 ga3];
@Az = [gaz1 gaz2 gaz3];
@B = [gb1 gb2];
@Bz = [gbz1 gbz2];
@C = [gc1 gc2 gc3];
@Cz = [gcz1 gcz2 gcz3];

@P = [@A @B];
@Pz = [@Az @Bz];
@Q = [@C];
@R = [gr1 gr2 gr3];

@X = [@P @Q];
@Xz = [@Pz @R];

lookup test2 {
    sub @X @all  by  @Xz;
} test2;
