@base = [A B C];
@left = [a b c];
@right = [one two three];
@all = [@base @left @right];

lookup test {
do  forlet i,b = enumerate(feaclass('base'));
    let l = feaclass('left')[i];
    let r = feaclass('right')[i];
    {
    sub $b by $l $r;
    }
} test;

lookup test1 {
    sub @all @right by @all;
} test1;

