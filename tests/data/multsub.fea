@base = [A B C];
@left = [a b c];
@right = [one two three];
@all = [@base @left @right];
lookup test {
            sub A by a one;
        sub B by b two;
        sub C by c three;

} test;

lookup test1 {
    sub A @right by A;
    sub B @right by B;
    sub C @right by C;
    sub a @right by a;
    sub b @right by b;
    sub c @right by c;
    sub one @right by one;
    sub two @right by two;
    sub three @right by three;
} test1;
