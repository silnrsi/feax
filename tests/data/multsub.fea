@base = [A B C];
@left = [a b c];
@right = [one two three];
@all = [@base @left @right];
lookup test {
            sub A by a one;
        sub B by b two;
        sub C by c three;

} test;

lookup test1 {
    sub A @right by A;
    sub B @right by B;
    sub C @right by C;
    sub a @right by a;
    sub b @right by b;
    sub c @right by c;
    sub one @right by one;
    sub two @right by two;
    sub three @right by three;
} test1;

@A = [ga1 ga2 ga3];
@Az = [gaz1 gaz2 gaz3];
@B = [gb1 gb2];
@Bz = [gbz1 gbz2];
@C = [gc1 gc2 gc3];
@Cz = [gcz1 gcz2 gcz3];
@P = [@A @B];
@Pz = [@Az @Bz];
@Q = [@C];
@R = [gr1 gr2 gr3];
@X = [@P @Q];
@Xz = [@Pz @R];
lookup test2 {
    sub ga1 @all by gaz1;
    sub ga2 @all by gaz2;
    sub ga3 @all by gaz3;
    sub gb1 @all by gbz1;
    sub gb2 @all by gbz2;
    sub gc1 @all by gr1;
    sub gc2 @all by gr2;
    sub gc3 @all by gr3;
} test2;

